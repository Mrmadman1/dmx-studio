{
	"name": "dmx-studio",
	"version": "0.1.0",
	"private": true,
	"description": "Easy light-show maker for DMX fixtures",
	"main": "electron/main.cjs",
	"scripts": {
		"dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && electron .\"",
		"build": "tsc --noEmit && vite build",
		"start": "vite build && electron .",
		"typecheck": "tsc --noEmit",
		"dist": "vite build && electron-builder --win nsis --x64"
	},
	"dependencies": {
		"serialport": "^12.0.0"
	},
	"devDependencies": {
		"@react-three/drei": "^9.122.0",
		"@react-three/fiber": "^8.18.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@types/three": "^0.169.0",
		"@vitejs/plugin-react": "^4.3.4",
		"concurrently": "^9.1.0",
		"electron": "^33.2.0",
		"electron-builder": "^26.18.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tailwindcss": "^4.0.0",
		"three": "^0.169.0",
		"typescript": "^5.6.3",
		"vite": "^6.0.0",
		"wait-on": "^8.0.1",
		"zustand": "^5.0.0"
	},
	"allowScripts": {
		"electron@33.4.11": true,
		"@serialport/bindings-cpp@12.0.1": true,
		"esbuild@0.25.12": true
	},
	"author": "DMX Studio",
	"build": {
		"appId": "app.dmxstudio.desktop",
		"productName": "DMX Studio",
		"asar": false,
		"npmRebuild": false,
		"directories": {
			"output": "release",
			"buildResources": "build"
		},
		"files": [
			"electron/**/*",
			"dist/**/*",
			"assets/**/*",
			"package.json",
			"!**/node_modules/@serialport/bindings-cpp/prebuilds/{android-arm,android-arm64,darwin-x64+arm64,linux-arm,linux-arm64,linux-x64,win32-ia32}/**"
		],
		"electronLanguages": [
			"en-US"
		],
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "build/icon.ico"
		},
		"nsis": {
			"oneClick": false,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "DMX Studio",
			"artifactName": "DMX-Studio-Setup-${version}.exe",
			"deleteAppDataOnUninstall": false
		}
	}
}
